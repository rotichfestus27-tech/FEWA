{
    "functions": {
        "source": "functions"
    },
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            ".git/**",
            "**/node_modules/**",
            "firestore.rules",
            "firestore.indexes.json",
            "storage.rules",
            "functions/**",
            "server/**",
            "test/**",
            "scripts/README.md",
            "scripts/roles.md",
            "scripts/seed_students.js",
            "scripts/seed_students.json",
            "package.json",
            "package-lock.json",
            "README.md",
            "README_TESTS.md",
            "mockup.html",
            "rules_playground_tests.json",
            "**/*.log",
            "*-test-output.txt",
            "*-test-error.txt"
        ],
        "cleanUrls": true,
        "headers": [
            {
                "source": "**/*.@(css|webp|png|jpg|jpeg|svg|woff2)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "/courses/**",
                "destination": "/course-detail.html"
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "singleProjectMode": false,
        "firestore": {
            "port": 8080
        },
        "auth": {
            "port": 9099
        },
        "storage": {
            "port": 9199
        }
    }
}